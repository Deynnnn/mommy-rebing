# Railway Postgres (use DATABASE_PUBLIC_URL when running locally)
DATABASE_URL=postgresql://postgres:pass@host:port/railway

# Railway Bucket (S3-compatible) — copy from the bucket's Variables/Credentials tab
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# set to "true" only if your bucket requires path-style URLs
S3_FORCE_PATH_STYLE=false

# Secret for /admin?key=...
ADMIN_KEY=change-me-to-something-long

# Public URL of the deployed site (used in QR codes)
NEXT_PUBLIC_SITE_URL=https://your-app.up.railway.app
